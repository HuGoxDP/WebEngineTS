{
  "compilerOptions": {
    /* Language & Output */
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],

    /* Strictness */
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": false,

    /* .ts extension imports — Rollup handles actual emit */
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Emit (used when extended by tsconfig.build.json) */
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "importHelpers": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    /* Paths — for IDE only, Rollup resolves differently */
    "baseUrl": ".",
    "paths": {
      "WebEngineTS": ["./src/engine/index.ts"]
    },

    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}