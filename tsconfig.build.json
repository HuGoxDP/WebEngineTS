{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "noEmit": true
  },
  "include": ["src/engine/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/main.ts",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}